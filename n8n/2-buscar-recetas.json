      },
      {
        "parameters": {
          "jsCode": "const body = $json.body ?? {};\nconst ingredientes = String(body.ingredientes ?? '').trim();\n\nif (!ingredientes) throw new Error('Faltan los ingredientes');\n\nreturn [{ json: {\n  ingredientes,\n  qdrant_url: 'http://qdrant:6333',\n  coleccion: 'recetas',\n  modelo_embedding: 'openai/text-embedding-3-small',\n  modelo_chat: 'openai/gpt-4.1-mini',\n  limite: 5\n} }];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          0
        ],
        "id": "3f002ab6-291b-4333-955d-e9a5eff6314c",
        "name": "Preparar busqueda"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://openrouter.ai/api/v1/embeddings",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpBearerAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ model: $json.modelo_embedding, input: 'Ingredientes disponibles: ' + $json.ingredientes, encoding_format: 'float' }) }}",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
